{
    "compilerOptions": {
        "removeComments": true,
        "preserveConstEnums": true,
        "noImplicitReturns": true,
        // TypeScript 6 turns all of `strict` on by default; this project enables its parts one by
        // one (wiki/code_quality.md Q10), so the default is switched off and the flags in use listed
        "strict": false,
        "alwaysStrict": true, // emit "use strict"
        "skipLibCheck": true,
        "noImplicitAny": true,
        "noImplicitThis": true,
        "outDir": "js",
        "rootDir": "src",
        "target": "es2021",
        "lib": ["es2021", "dom"],
        "allowJs": true,
        // js/**/*.js.map (gitignored, *.map): browser stack traces and breakpoints show the .ts
        "sourceMap": true
    },

    "include": ["src/**/*"],
    "exclude": ["node_modules"]
}
