{
    "compilerOptions": {
        "removeComments": true,
        "preserveConstEnums": true,
        "noImplicitReturns": true,
        // all strict checks (wiki/code_quality.md Q10); a value the code knows is set is marked `!`
        "strict": true,
        "skipLibCheck": true,
        "outDir": "js",
        "rootDir": "src",
        "target": "es2021",
        "lib": ["es2021", "dom"],
        "allowJs": true,
        // js/**/*.js.map (gitignored, *.map): browser stack traces and breakpoints show the .ts
        "sourceMap": true
    },

    "include": ["src/**/*"],
    "exclude": ["node_modules"]
}
