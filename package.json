{
  "name": "darkharold2",
  "private": true,
  "description": "Browser recreation of Fallout 2 (TypeScript + WebGL 2), forked from DarkFO",
  "license": "Apache-2.0",
  "scripts": {
    "build": "tsc -p .",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:ratchet": "node tools/eslintRatchet.mjs",
    "pretest": "tsc -p .",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./test/support/register.mjs --test \"test/*.test.mjs\"",
    "parity": "tsc -p . && node tools/parity.mjs",
    "smoke": "tsc -p . && node tools/smoke.mjs",
    "storycrawl": "tsc -p . && node tools/storycrawl.mjs",
    "format": "prettier --write \"src/**/*.{ts,js}\"",
    "format:check": "prettier --check \"src/**/*.{ts,js}\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "playwright": "^1.64.1",
    "prettier": "3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2"
  },
  "engines": {
    "node": ">=22"
  }
}
